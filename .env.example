# Insurance Verify — every runtime option. Copy to .env (gitignored) and fill in.
# All keys are optional per tier: IV_MODE=mock runs with no keys and no model calls.

# Runtime tier:
#   mock — stubbed extraction from the card's sidecar answer key, mock 271,
#          demo labels, no Q&A chat. No keys, no network.
#   llm  — real VLM OCR on the card image, mock 271, demo labels, Q&A chat.
#          Needs the key for the model providers the tier's models use.
#   live — real VLM OCR, real Stedi 270/271, Q&A chat. Needs Stedi plus the
#          model providers' keys.
IV_MODE=mock

# Model backend, chosen by the model name's prefix:
#   "openrouter:<model>"  -> OpenRouter (cloud, needs IV_OPENROUTER_API_KEY)
#   "openai:<model>"      -> OpenAI (cloud, needs IV_OPENAI_API_KEY)
#   "local:<model>"       -> the local model server; a bare model name is the
#                            same thing — nothing leaves the machine
# Vision model (card OCR) and ask model (benefit Q&A chat) are chosen separately.
IV_VISION_MODEL=openai:gpt-6-luna
IV_ASK_MODEL=openai:gpt-6-luna

# API keys — never committed. Only the keys the selected models' providers need
# are checked; IV_MODE=mock ignores all of them. Plain OPENROUTER_API_KEY /
# OPENAI_API_KEY work as fallbacks for the IV_ prefixed names.
IV_OPENROUTER_API_KEY=
IV_OPENAI_API_KEY=
# Stedi API key (sandbox or production) — required only in live mode.
STEDI_API_KEY=

# Local model backend: the server's OpenAI-compatible endpoint root, used for
# "local:" models (and bare model names). llama.cpp server, Strata, Ollama,
# LM Studio, vLLM — any server that speaks the OpenAI chat format works.
IV_LOCAL_URL=http://localhost:11434/v1

# Paths: synthetic card data directory (generated by scripts/capture_fixtures.py
# and the card generator).
IV_DATA_DIR=synth/output

# Extraction confidence below which the run escalates to human review.
IV_CONFIDENCE_THRESHOLD=0.7
